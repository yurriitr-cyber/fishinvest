# Database
DATABASE_URL=postgresql://rarefish:rarefish@localhost:5432/rarefish?schema=public

# Redis (optional / local docker-compose only — not required by app today)
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=rarefishinvestment_bot
TELEGRAM_MINI_APP_NAME=app

# Mini App
# Local: Vite http://localhost:5180
# Railway: https://<web.RAILWAY_PUBLIC_DOMAIN>
WEBAPP_URL=http://localhost:5180
# Also set WEBAPP_URL on the API service so /me returns https://…/invite/<code>
# (Telegram shows the invite banner from that page’s Open Graph tags).

# Browser → API. Leave empty for same-origin `/api` (Vite proxy or Railway web proxy).
# Example if calling API directly: https://api-xxxx.up.railway.app
VITE_API_URL=

# Bot / internal → API
# Local: http://localhost:3000/api
# Railway private: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}/api
API_INTERNAL_URL=http://localhost:3000/api

# Web service proxy target (origin only, no /api suffix)
# Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_PROXY_TARGET=http://127.0.0.1:3000

INTERNAL_API_SECRET=dev-internal-secret-change-me

# Payments / conversion
STARS_TO_GAME_CREDIT_RATE=1
STARS_DEPOSIT_FEE_PERCENT=0
# Approx USD per Telegram Star (used for TON → credits)
STAR_USD_PRICE=0.02
# TON wallet that receives deposits (enables TON provider on API boot)
TON_DEPOSIT_ADDRESS=
# Bonus credits on TON deposits (default 15)
TON_DEPOSIT_BONUS_PERCENT=15
ORACLE_TTL_SECONDS=30
# Optional TonAPI key (https://tonconsole.com) — improves reliability
TONAPI_KEY=
ADMIN_API_SECRET=
# Comma-separated Telegram user ids allowed into /admin
ADMIN_TELEGRAM_IDS=1001

# App
PORT=3000
NODE_ENV=development
INITIAL_BONUS_AMOUNT=200
REFERRAL_BONUS_AMOUNT=300
REFERRAL_JOIN_BONUS_AMOUNT=50
REFERRAL_ENABLED=true
PRICE_UPDATE_INTERVAL=3s

# Production (Railway api start script)
# RUN_SEED=true runs idempotent upserts on each api boot; set false after first deploy if you prefer
RUN_SEED=true
