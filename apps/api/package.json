{
  "name": "@rare-fish/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @rare-fish/shared build && pnpm --filter @rare-fish/db generate && pnpm --filter @rare-fish/db build",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "pnpm --filter @rare-fish/db exec prisma migrate deploy && pnpm --filter @rare-fish/db seed && node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@rare-fish/db": "workspace:*",
    "@rare-fish/shared": "workspace:*",
    "@telegram-apps/init-data-node": "^1.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
